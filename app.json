{
  "expo": {
    "name": "Dream Journal",
    "slug": "dreamjournal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dreamjournal",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0b1026"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dreamjournal.app"
    },
    "android": {
      "package": "com.dreamjournal.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#8b7cf6"
        }
      ]
    ]
  }
}
